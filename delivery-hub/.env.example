# ─────────────────────────────────────────────
# delivery-hub 환경설정 예시
# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 절대 커밋하지 마세요.
# ─────────────────────────────────────────────

# true 이면 모든 플랫폼이 샘플 데이터로 동작합니다 (계약/계정 없이 실행 가능)
MOCK_MODE=true

# 대시보드 서버 (기본은 내 컴퓨터에서만 접속 가능한 127.0.0.1)
HOST=127.0.0.1
PORT=8787

# 낮은 별점 기준 (이 값 이하를 강조 표시)
LOW_RATING_THRESHOLD=3

# ── 하이픈(Hyphen) API마켓 ── 계약 후 발급되는 값
# TODO: 실제 Base URL·인증 헤더 이름은 계약 후 받는 연동 가이드로 확인
HYPHEN_BASE_URL=https://api.hyphen.im
HYPHEN_USER_ID=
HYPHEN_HKEY=
HYPHEN_TIMEOUT_MS=60000

# ── 배달의민족 사장님 계정 (하이픈 '계정검증'·조회에 사용) ──
BAEMIN_LOGIN_ID=
BAEMIN_LOGIN_PW=

# ── 쿠팡이츠 사장님 계정 ──
COUPANGEATS_LOGIN_ID=
COUPANGEATS_LOGIN_PW=

# ── 먹깨비 ── 하이픈 상품이 없어 사장님 센터 엑셀/CSV 내보내기 파일을 가져옵니다
# 이 폴더에 파일이 있으면 그 데이터를 쓰고, 없으면 MOCK_MODE 에 따라 샘플 데이터를 씁니다
MUKKEBI_IMPORT_DIR=./data/mukkebi
